+static void Release_Super_Mount_Holders() {
+	property_set("twrp.crypto.runtime.released", "1");
+
+	static const char* const kHolders[] = {
+		"thp-touch",
+		"keystore2",
+		"vendor.weaver_nxp",
+		"vendor.gatekeeper_mitee",
+		"vendor.keymint-mitee",
+		"se_omapi",
+		"vendor.secure_element_hal_service",
+		"vendor.mitee.mtdservice",
+	};
+
+	for (const char* svc : kHolders) {
+		const std::string key = std::string("init.svc.") + svc;
+		if (android::base::GetProperty(key, "") == "running") {
+			android::base::SetProperty("ctl.stop", svc);
+		}
+	}
+
+	for (int i = 0; i < 30; ++i) {
+		bool any_running = false;
+		for (const char* svc : kHolders) {
+			const std::string key = std::string("init.svc.") + svc;
+			if (android::base::GetProperty(key, "") == "running") {
+				any_running = true;
+				break;
+			}
+		}
+		if (!any_running) {
+			break;
+		}
+		usleep(100000);
+	}
+
+	static const char* const kHelperMounts[] = {
+		"/mnt_sys",
+		"/mnt_vendor",
+		"/mnt/vendor/mi_ext",
+		"/mi_ext",
+		"/odm",
+		"/vendor",
+		"/system_ext",
+		"/product",
+		"/vendor_dlkm",
+		"/odm_dlkm",
+		"/system_dlkm",
+		"/system",
+		"/system_root",
+	};
+
+	for (const char* path : kHelperMounts) {
+		if (umount(path) != 0 && errno == EBUSY) {
+			usleep(100000);
+			if (umount(path) != 0) {
+				LOGINFO("umount(%s) deferred/failed: %s\n", path, strerror(errno));
+			}
+		}
+	}
+}
+
+static bool Destroy_Logical_With_Retry(const std::string& name) {
+	for (int attempt = 0; attempt < 5; ++attempt) {
+		if (DestroyLogicalPartition(name)) {
+			return true;
+		}
+		usleep(100000);
+	}
+	return false;
+}
+
+static void Remove_Logical_ByName_Symlink(const std::string& bare_name) {
+	const std::string dirs[] = {
+		"/dev/block/by-name/" + bare_name,
+		"/dev/block/bootdevice/by-name/" + bare_name,
+	};
+	for (const std::string& link : dirs) {
+		char target[PATH_MAX];
+		ssize_t len = readlink(link.c_str(), target, sizeof(target) - 1);
+		if (len > 0) {
+			target[len] = '\0';
+			if (strncmp(target, "/dev/block/dm-", 14) == 0) {
+				unlink(link.c_str());
+			}
+		}
+	}
+}
