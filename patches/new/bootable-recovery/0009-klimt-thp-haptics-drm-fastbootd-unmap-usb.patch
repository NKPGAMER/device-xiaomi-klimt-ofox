+// SIH688X driver exposes haptics directly on its I2C device (0-006b on rodin, 1-006b on klimt).
+static const std::string& get_sih_haptics_dir() {
+    static std::string cached_dir;
+    if (!cached_dir.empty()) return cached_dir;
+    static const char* const kCandidates[] = {
+        "/sys/bus/i2c/drivers/sih_haptic_688X/1-006b",
+        "/sys/bus/i2c/drivers/sih_haptic_688X/0-006b",
+    };
+    for (const char* dir : kCandidates) {
+        if (std::ifstream(std::string(dir) + "/activate").good()) {
+            cached_dir = dir;
+            return cached_dir;
+        }
+    }
+    cached_dir = kCandidates[0];
+    return cached_dir;
+}
 
 #ifndef SYN_REPORT
 #define SYN_REPORT          0x00
@@ -191,9 +203,30 @@ int vibrate(int timeout_ms)
     if (std::ifstream(LEDS_HAPTICS_ACTIVATE_FILE).good()) {
         write_to_file(LEDS_HAPTICS_DURATION_FILE, tout);
         write_to_file(LEDS_HAPTICS_ACTIVATE_FILE, "1");
-    } else if (std::ifstream(SIH_HAPTICS_ACTIVATE_FILE).good()) {
-        write_to_file(SIH_HAPTICS_DURATION_FILE, tout);
-        write_to_file(SIH_HAPTICS_ACTIVATE_FILE, "1");
+    } else if (std::ifstream(get_sih_haptics_dir() + "/activate").good()) {
+        const std::string& sih_dir = get_sih_haptics_dir();
+        int strength = timeout_ms;
+        if (strength < 1) strength = 1;
+        if (strength > 100) strength = 100;
+
+        // SIH688X recovery strength range.
+        // 0x1e is the driver baseline; 0x80 is the highest
+        // gain verified successfully during real-device testing.
+        const int min_gain = 0x1e;
+        const int max_gain = 0x80;
+        const int gain =
+            min_gain + ((max_gain - min_gain) * strength + 50) / 100;
+
+        // Effect 7 is calibrated short granular haptic.
+        write_to_file(sih_dir + "/activate", "0");
+        write_to_file(sih_dir + "/effect_id", "7");
+        write_to_file(sih_dir + "/activate", "1");
+
+        // activate_store asynchronously restores the driver default gain.
+        // Real-device testing shows a 1 ms settle is sufficient before
+        // applying the requested strength.
+        usleep(1000);
+        write_to_file(sih_dir + "/gain", std::to_string(gain));
     } else {
         write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
     }
